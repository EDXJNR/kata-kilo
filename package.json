{
  "name": "kata-kilo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"npm run dev\" \"npm run worker:dev\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --host",
    "preview:tunnel": "npm run build && concurrently -n preview,tunnel -c cyan,yellow \"vite preview --host --port 4173\" \"npx --yes cloudflared tunnel --url http://localhost:4173\"",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name=kata-kilo",
    "worker:dev": "npm run dev --prefix worker",
    "worker:deploy": "npm run deploy --prefix worker"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "oxlint": "^1.75.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.0.0"
  }
}
